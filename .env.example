NODE_ENV=development
PORT=8000

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
RATE_LIMIT_MAX=100

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db_padelo
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# JWT
JWT_SECRET=
JWT_EXPIRATION_TIME="1d"
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION_TIME="7d"

# Default Admin User for Seeding
DEFAULT_ADMIN_EMAIL=admin@test.dev
DEFAULT_ADMIN_PASSWORD=123qweasd

# Logging
LOG_LEVEL=debug
MIDTRANS_SERVER_KEY=
# Optional: override the automatically detected Snap endpoint.
# Sandbox keys (prefix SB-) use https://app.sandbox.midtrans.com/snap/v1/transactions
# Production keys (prefix Mid-) use https://app.midtrans.com/snap/v1/transactions
MIDTRANS_SNAP_URL=
KOMERCE_API_KEY="your-komerce-api-key"
KOMERCE_TARIFF_BASE_URL="https://api-sandbox.collaborator.komerce.id/tariff/api/v1"
KOMERCE_ORDER_BASE_URL="https://api-sandbox.collaborator.komerce.id/order/api/v1"
KOMERCE_SHIPPER_DESTINATION_ID=68423
KOMERCE_ORIGIN_PIN_POINT="-6.160167, 106.71606"
CEK_RESI_URL="http://localhost:8001/cek-resi"