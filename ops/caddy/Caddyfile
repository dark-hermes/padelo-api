{
  email admin@kebunify.my.id
  debug
}

padelo.kebunify.my.id {
  encode gzip zstd
  header {
    -Server
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-XSS-Protection "0"
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  }

  reverse_proxy padelo-api:3000 {
    # Caddy forwards necessary headers by default
  }

  # Simple health endpoint for external checks
  respond /health 200
}