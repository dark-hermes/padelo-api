generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  password      String
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  roles         UserRole[]
  refreshTokens RefreshToken[]

  addresses Address[]
  cartItems CartItem[]
  orders    Order[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id         String           @id @default(cuid())
  action     String // e.g., 'create', 'read', 'update', 'delete'
  subject    String // e.g., 'User', 'Role', 'Article'
  // Optional: for field-level security
  fields     String[]
  // Optional: for row-level security conditions
  conditions Json?
  inverted   Boolean          @default(false) // 'cannot' rule if true
  reason     String?
  roles      RolePermission[]
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId String

  @@id([userId, roleId])
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  position  String
  image     String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  pageContent Json
  coverImage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants ProductVariant[]
}

model ProductVariant {
  id   String @id @default(cuid())
  name String

  price  Decimal @db.Decimal(12, 2)
  sku    String  @unique
  stock  Int     @default(0)
  weight Decimal @db.Decimal(10, 3)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    ProductImage[]
  CartItem  CartItem[]
  OrderItem OrderItem[]
}

model ProductImage {
  id      String  @id @default(cuid())
  url     String
  altText String?

  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productVariantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  id   String @id @default(cuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Address {
  id                   String  @id @default(cuid())
  label                String
  recipient            String
  phone                String
  address              String
  city                 String
  province             String
  postalCode           String
  komerceDestinationId Int?
  komercePinPoint      String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// (Temporary)
model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
}

// --- Model Order (Permanent) ---
model Order {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique @default(cuid()) // For Customer & Midtrans
  status        OrderStatus @default(PENDING)

  // --- Pricing Snapshot ---
  totalProductAmount       Decimal  @db.Decimal(12, 2)
  shippingCost             Decimal  @db.Decimal(12, 2)
  totalAmount              Decimal  @db.Decimal(12, 2)
  // Komerce detailed shipping cost snapshot (optional)
  shippingCostOriginal     Decimal? @db.Decimal(12, 2) // original cost (e.g. net or base)
  shippingCostEstimatedMin Decimal? @db.Decimal(12, 2) // estimated min with margin
  shippingCostEstimatedMax Decimal? @db.Decimal(12, 2) // estimated max with margin

  // --- Shipping Info Snapshot ---
  shippingAddress     Json? // Simpan alamat lengkap sebagai JSON
  shippingCourier     String? // misal: "JNE REG"
  shippingResi        String? // Nomor resi, diisi saat pengiriman
  shippingName        String? // e.g. JNE, JNT
  shippingServiceName String? // e.g. REG, EZ

  // --- Payment info ---
  paymentToken String? // Midtrans payment token
  paidAt       DateTime? // Filled when PAID webhook received

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  items OrderItem[]
}

// --- Model Item di dalam Order (Permanent Snapshot) ---
model OrderItem {
  id          String  @id @default(cuid())
  // --- Snapshot Produk ---
  // Kita simpan data ini agar jika produk aslinya berubah nama/harga,
  // data di order ini tidak ikut berubah.
  productName String
  variantName String
  quantity    Int
  price       Decimal @db.Decimal(12, 2) // Harga satuan SAAT dibeli

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
}

model Landing {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())

  // Relasi
  reviews       LandingReview[]
  imagesProduct LandingImageProduct[]
  videos        LandingVideo[]
}

model LandingReview {
  id        Int      @id @default(autoincrement())
  name      String
  comment   String
  rating    Int
  createdAt DateTime @default(now())

  // Foreign key
  landingId Int
  landing   Landing @relation(fields: [landingId], references: [id])
}

model LandingImageProduct {
  id          Int      @id @default(autoincrement())
  url         String
  title       String?
  description String?
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  // Foreign key
  landingId Int
  landing   Landing @relation(fields: [landingId], references: [id])
}

model LandingVideo {
  id        Int      @id @default(autoincrement())
  url       String
  title     String?
  createdAt DateTime @default(now())

  // Foreign key
  landingId Int
  landing   Landing @relation(fields: [landingId], references: [id])
}

enum OrderStatus {
  PENDING // Menunggu pembayaran
  PAID // Sudah dibayar
  PROCESSING // Sedang disiapkan/diproses
  SHIPPED // Sudah dikirim
  COMPLETED // Selesai (diterima)
  CANCELLED // Dibatalkan
}
