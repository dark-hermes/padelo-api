{
  "info": {
    "name": "Padelo API - Cart, Shipping & Orders",
    "_postman_id": "7a1c7f1c-5c21-4b2c-8a5e-62cb6cf6a8fb",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection covering cart operations, checkout/orders, and Komerce shipping helpers. Use the Auth request first to store the `authCookie` variable before calling protected endpoints."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (stores authCookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cookies = pm.response.headers.all().filter((h) => h.key.toLowerCase() === 'set-cookie').map((h) => h.value);",
                  "const accessCookie = cookies.find((cookie) => cookie.startsWith('access_token='));",
                  "if (accessCookie) {",
                  "  pm.environment.set('authCookie', accessCookie.split(';')[0]);",
                  "  console.log('authCookie stored for reuse');",
                  "} else {",
                  "  pm.environment.unset('authCookie');",
                  "  pm.test('Access token cookie present', () => false);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
